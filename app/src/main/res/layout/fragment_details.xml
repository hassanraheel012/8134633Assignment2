<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coursenest_cream"
    android:orientation="vertical"
    tools:context=".ui.details.DetailsFragment">

    <!-- Top bar with the back button -->
    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/buttonBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_button_light"
            android:contentDescription="@string/details_back"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/coursenest_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="@font/fredoka_semibold"
            android:text="@string/details_title"
            android:textColor="@color/coursenest_dark"
            android:textSize="18sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="32dp">

            <!-- Header card: icon, course code and title -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/coursenest_dark"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_icon_tile_orange">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_course_book"
                                app:tint="@color/coursenest_white" />
                        </FrameLayout>

                        <!-- Hidden when the course has no code -->
                        <TextView
                            android:id="@+id/textDetailsCode"
                            style="@style/Widget.CourseNest.Badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:textSize="13sp"
                            tools:text="NIT3213" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textDetailsTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/fredoka_bold"
                        android:textColor="@color/coursenest_white"
                        android:textSize="24sp"
                        tools:text="Mobile Application Development" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Course information: every field except the title -->
            <LinearLayout
                android:id="@+id/layoutInfoSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:text="@string/details_information"
                    android:textAppearance="@style/TextAppearance.CourseNest.SectionTitle"
                    android:textSize="18sp"
                    app:drawableStartCompat="@drawable/ic_info"
                    app:drawableTint="@color/coursenest_orange" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.CourseNest.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_detail_row" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Description, kept separate from the course information -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/details_description"
                android:textAppearance="@style/TextAppearance.CourseNest.SectionTitle"
                android:textSize="18sp"
                app:drawableStartCompat="@drawable/ic_description"
                app:drawableTint="@color/coursenest_orange" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CourseNest.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/coursenest_soft_cream">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Orange accent edge -->
                    <View
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:background="@color/coursenest_orange" />

                    <TextView
                        android:id="@+id/textDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/fredoka_regular"
                        android:lineSpacingExtra="5dp"
                        android:padding="18dp"
                        android:textColor="@color/coursenest_dark"
                        android:textIsSelectable="true"
                        android:textSize="15sp"
                        tools:text="A detailed description of the course." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
