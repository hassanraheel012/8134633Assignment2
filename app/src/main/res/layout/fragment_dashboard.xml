<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coursenest_cream"
    tools:context=".ui.dashboard.DashboardFragment">

    <!-- Dark welcome header (sits behind the status bar) -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dashboard_header"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Brand row with the log out button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_coursenest_logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/fredoka_semibold"
                android:text="@string/app_name"
                android:textColor="@color/coursenest_white"
                android:textSize="20sp" />

            <ImageButton
                android:id="@+id/buttonLogout"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_button_dark"
                android:contentDescription="@string/dashboard_logout"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_logout"
                app:tint="@color/coursenest_white" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/fredoka_regular"
            android:text="@string/dashboard_welcome"
            android:textColor="@color/coursenest_grey_light"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textStudent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fredoka_bold"
            android:textColor="@color/coursenest_white"
            android:textSize="28sp"
            tools:text="Student 8134633" />

        <!-- Topic (from the login keypass) and the number of loaded courses -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textTopic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_orange"
                android:drawablePadding="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/fredoka_semibold"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:textColor="@color/coursenest_white"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_school"
                app:drawableTint="@color/coursenest_white"
                tools:text="Courses" />

            <TextView
                android:id="@+id/textCourseCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_dark"
                android:fontFamily="@font/fredoka_medium"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:textColor="@color/coursenest_cream"
                android:textSize="13sp"
                android:visibility="invisible"
                tools:text="7 courses"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/textSectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="@dimen/screen_margin"
        android:text="@string/dashboard_section_title"
        android:textAppearance="@style/TextAppearance.CourseNest.SectionTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader" />

    <TextView
        android:id="@+id/textSectionSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="@dimen/screen_margin"
        android:text="@string/dashboard_section_subtitle"
        android:textAppearance="@style/TextAppearance.CourseNest.Body"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textSectionTitle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCourses"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="14dp"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/screen_margin"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textSectionSubtitle"
        tools:listitem="@layout/item_course"
        tools:visibility="visible" />

    <!-- Loading, empty and error states -->
    <LinearLayout
        android:id="@+id/layoutStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textSectionSubtitle">

        <ProgressBar
            android:id="@+id/progressDashboard"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:indeterminateTint="@color/coursenest_orange" />

        <ImageView
            android:id="@+id/imageStatus"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_icon_tile"
            android:importantForAccessibility="no"
            android:padding="16dp"
            android:visibility="gone"
            app:tint="@color/coursenest_orange"
            tools:src="@drawable/ic_cloud_off" />

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.CourseNest.Body"
            tools:text="@string/dashboard_loading" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRetry"
            style="@style/Widget.CourseNest.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dashboard_retry"
            android:visibility="gone" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
