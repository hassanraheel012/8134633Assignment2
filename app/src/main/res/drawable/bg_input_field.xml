<?xml version="1.0" encoding="utf-8"?>
<!-- White rounded input. The border turns orange while the field is focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/coursenest_white" />
            <stroke
                android:width="1.5dp"
                android:color="@color/coursenest_orange" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/coursenest_white" />
            <stroke
                android:width="1dp"
                android:color="@color/coursenest_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
